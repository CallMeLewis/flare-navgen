{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: core APIs, its own title bar (moving, minimising, maximising and closing), its zoom for the interface size, file dialogs and its own updates.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-destroy",
    "core:window:allow-minimize",
    "core:window:allow-close",
    "core:window:allow-toggle-maximize",
    "core:window:allow-start-dragging",
    "core:webview:allow-set-webview-zoom",
    "dialog:default",
    "flare-updater:default"
  ]
}
